{
  "name": "levelup-nitk",
  "version": "1.0.0",
  "description": "An AI-Powered Gamified Learning & Competitive Coding Platform for NIT Kurukshetra",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "server": "nodemon server/server.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm run build --prefix client",
    "seed": "node server/seed/seed.js"
  },
  "keywords": [
    "nit-kurukshetra",
    "gamified-learning",
    "competitive-coding",
    "lms",
    "ai-roadmap",
    "ats-resume",
    "mern"
  ],
  "author": "LevelUp NITK Team",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.0"
  }
}
